# Copy to .env and fill in.  Never commit .env.
# Keep exactly ONE line per variable (a duplicated POSTGRES_PASSWORD line
# silently overrides the first one and causes "password authentication failed").
POSTGRES_USER=notam
POSTGRES_PASSWORD=change_me
POSTGRES_DB=notam
# Local Windows PostgreSQL 14 in this project listens on 5433 (Docker uses 5432).
# The password inside DATABASE_URL must equal POSTGRES_PASSWORD.
DATABASE_URL=postgresql://notam:change_me@localhost:5433/notam
REDIS_URL=redis://localhost:6379/0
FAA_API_CLIENT_ID=
FAA_API_CLIENT_SECRET=
ICAO_API_KEY=
AUTOROUTER_USER=
AUTOROUTER_PASSWORD=
OPENAIP_API_KEY=
